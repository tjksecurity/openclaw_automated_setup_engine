# OpenClaw setup engine — environment
#
# Tip: instead of editing this file by hand, run the app and open the wizard
# at http://localhost:3000/setup. It walks you through every option with
# tooltips, validates input, and writes .env for you.

# --- Point the frontend at the backend (only needed for prod deploys) ---
# API_URL=http://backend:8000

# --- Model provider keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Integration keys (only fill in the ones you use) ---
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
PINECONE_API_KEY=
WEAVIATE_URL=
E2B_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENCLAW_S3_BUCKET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
GITHUB_TOKEN=
NOTION_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
