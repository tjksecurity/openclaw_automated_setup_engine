{
  "name": "openclaw-setup-engine",
  "version": "0.2.0",
  "description": "Local web-based setup wizard for OpenClaw. Installs OpenClaw, writes ~/.openclaw/openclaw.json, wires up messaging channels, and starts the daemon.",
  "keywords": [
    "openclaw",
    "setup",
    "wizard",
    "agent",
    "cli"
  ],
  "homepage": "https://github.com/tjksecurity/openclaw_automated_setup_engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjksecurity/openclaw_automated_setup_engine.git"
  },
  "license": "MIT",
  "author": "tjksecurity",
  "bin": {
    "openclaw-setup-engine": "bin/openclaw-setup-engine.js"
  },
  "files": [
    "bin/",
    ".next/standalone/",
    ".next/static/",
    "public/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
